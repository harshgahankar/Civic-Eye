# ────────────────────────────────────────────────────────────────────────────
# Civic-Eye — example environment configuration
# Copy this file to .env and adjust values for your environment.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# App
APP_NAME=Civic-Eye
APP_ENV=development
DEBUG=true
VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./sentinel.db

# Logging (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO

# AI perception filtering (anti-ghost)
# AI_CONFIDENCE_THRESHOLD=0.5
# AI_ALLOWED_CLASSES=person,backpack,suitcase,handbag,car,bus,truck,motorcycle,bicycle
# AI_CLASS_CONFIDENCE=suitcase:0.25,handbag:0.25,backpack:0.25
# AI_CLASS_ALIASES=backpack:bag,suitcase:bag,handbag:bag
# AI_MIN_TRACK_AGE=3

# CORS — comma-separated origins OR JSON array
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Incident Intelligence (Step 4) ──
INCIDENT_EVIDENCE_WINDOW_SECONDS=5.0
ACCIDENT_MIN_EVIDENCE=3
ACCIDENT_CONFIRMATION_THRESHOLD=0.55
BAGGAGE_STATIONARY_SECONDS=10.0
BAGGAGE_OWNER_DISTANCE_THRESHOLD=120.0
BAGGAGE_MERGE_DISTANCE=60.0
BAGGAGE_CONFIRMATION_THRESHOLD=0.6
CROWD_ANOMALY_MIN_EVIDENCE=5
CROWD_ANOMALY_CONFIRMATION_THRESHOLD=0.55
INCIDENT_DEDUP_WINDOW_SECONDS=10.0
INCIDENT_COOLDOWN_SECONDS=30.0
SEVERITY_HIGH_THRESHOLD=0.6
SEVERITY_CRITICAL_THRESHOLD=0.85

# ── Step 5: multi-camera + real-time bus ──
MULTI_CAMERA_ENABLED=true
MULTI_CAMERA_TIME_WINDOW_SECONDS=15
MULTI_CAMERA_CORRELATION_THRESHOLD=0.70
MAX_EVENT_HISTORY=1000
WEBSOCKET_HEARTBEAT_SECONDS=30
CAMERA_OFFLINE_TIMEOUT_SECONDS=10
CAMERA_DEGRADED_FPS_THRESHOLD=5
MAX_WEBSOCKET_CLIENTS=100
